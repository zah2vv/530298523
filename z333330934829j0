        return nil
    end
    local KillRemote = findRemote("MainGameEvent") or findRemote("MainRemoteEvent")
    LoadoutRemote = findRemote("Loadout")
    
-- AMMO REFILL (UNBLOCKED - WORKS WITH RAPID FIRE)
local function requestAmmoRefill(tool)
    if LoadoutRemote == nil or tool == nil then return false end
    -- Remove the isRefilling block - let it refill even if "refilling"
    local ammo = tool:FindFirstChild("Ammo")
    if not ammo then return false end
    if ammo:GetAttribute("ZeeKillRefillRequested") then return false end
    if ammo.Value > 1 then return false end -- Only refill when 1 or less
    
    local char, bp = G.LP.Character, G.LP:FindFirstChild("Backpack")
    if bp == nil then return false end
    
    local gunName = tool.Name
    -- Don't set isRefilling to block, just use the attribute
    ammo:SetAttribute("ZeeKillRefillRequested", true)
    
    local reqName, oldTools, eqTools, newestTools, seen = tool.Name, {}, {}, {}, {}
    for _, cont in ipairs({bp, char}) do if cont then for _, item in ipairs(cont:GetChildren()) do if item:IsA("Tool") and item:FindFirstChild("Ammo") then oldTools[item] = true if item.Parent == char then eqTools[item.Name] = true end end end end end
    local conns, stopped, deadline, lastAdd = {}, false, os.clock() + 2.0, os.clock()
    local function stop() if stopped then return end stopped = true for _, conn in ipairs(conns) do pcall(function() conn:Disconnect() end) end if not newestTools[reqName] and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end end
    local function accept(item) if not item:IsA("Tool") or not item:FindFirstChild("Ammo") or oldTools[item] or seen[item] then return end seen[item], lastAdd = true, os.clock() local name = item.Name local prev = newestTools[name] if prev and prev ~= item and prev.Parent then prev:Destroy() end newestTools[name] = item for old in pairs(oldTools) do if old.Name == name and old.Parent and old ~= tool then old:Destroy() end end if eqTools[name] and char and item.Parent and item ~= tool then item.Parent = char end end
    conns[1] = bp.ChildAdded:Connect(accept) if char then conns[2] = char.ChildAdded:Connect(accept) end
    
    local allGuns = {} if bp then for _, item in ipairs(bp:GetChildren()) do if item:IsA("Tool") and item:FindFirstChild("Ammo") and item ~= tool then table.insert(allGuns, item.Name) end end end
    if char then local equipped = char:FindFirstChildOfClass("Tool") if equipped and equipped:FindFirstChild("Ammo") and equipped ~= tool then table.insert(allGuns, equipped.Name) end end
    table.insert(allGuns, tool.Name)
    LoadoutRemote:FireServer(allGuns)
    
    -- DETECTORS
    local refilled = false
    local detect1, detect2
    
    detect1 = bp.ChildAdded:Connect(function(child)
        if refilled then return end
        if child:IsA("Tool") and child.Name == gunName then
            refilled = true
            task.spawn(function()
                task.wait(0.05)
                local c = G.LP.Character
                if c and child.Parent == bp then
                    child.Parent = c
                end
                if detect1 then pcall(function() detect1:Disconnect() end) end
                if detect2 then pcall(function() detect2:Disconnect() end) end
                -- Clear the refill request
                task.wait(0.1)
                if ammo and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end
            end)
        end
    end)
    
    if char then
        detect2 = char.ChildAdded:Connect(function(child)
            if refilled then return end
            if child:IsA("Tool") and child.Name == gunName then
                refilled = true
                if detect1 then pcall(function() detect1:Disconnect() end) end
                if detect2 then pcall(function() detect2:Disconnect() end) end
                task.wait(0.1)
                if ammo and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end
            end
        end)
    end
    
    -- FALLBACK
    task.delay(0.8, function()
        if not refilled then
            local c = G.LP.Character
            local b = G.LP:FindFirstChild("Backpack")
            if c and b then
                local gt = b:FindFirstChild(gunName)
                if gt and not c:FindFirstChild(gunName) then
                    gt.Parent = c
                end
            end
            if detect1 then pcall(function() detect1:Disconnect() end) end
            if detect2 then pcall(function() detect2:Disconnect() end) end
            task.wait(0.1)
            if ammo and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end
        end
    end)
    
    -- Cleanup
    task.delay(2, function()
        if detect1 then pcall(function() detect1:Disconnect() end) end
        if detect2 then pcall(function() detect2:Disconnect() end) end
        if ammo and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end
    end)
    
    G.R.Heartbeat:Connect(function() if os.clock() >= deadline or (next(newestTools) and os.clock() - lastAdd >= 0.15) then stop() end end)
    return true
end

local function ForceRefillAllGuns()
    local char, bp = G.LP.Character, G.LP:FindFirstChild("Backpack")
    if not char and not bp then return end
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Ammo") then
        local ammo = tool:FindFirstChild("Ammo")
        if ammo.Value <= 3 and not ammo:GetAttribute("ZeeKillRefillRequested") then requestAmmoRefill(tool) end
    end
    if bp then for _, item in ipairs(bp:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Ammo") then
            local ammo = item:FindFirstChild("Ammo")
            if ammo.Value <= 3 and not ammo:GetAttribute("ZeeKillRefillRequested") then requestAmmoRefill(item) end
        end
    end end
end
    
    
    
