local rangeOn = false
local rangeValue = 999999

local _grm = getrawmetatable(game)
local _oldIndex = _grm.__index
setreadonly(_grm, false)

_grm.__index = function(self, key)
    if not checkcaller() and self == G.LP:GetMouse() then
        if rangeOn and key == "Hit" then
            local unitRay = _oldIndex(self, "UnitRay")
            if unitRay then
                local origin = unitRay.Origin
                local params = RaycastParams.new()
                params.FilterType = Enum.RaycastFilterType.Exclude
                params.FilterDescendantsInstances = { G.LP.Character }
                local res = G.W:Raycast(origin, unitRay.Direction * rangeValue, params)
                local hitPos = res and res.Position or (origin + unitRay.Direction * rangeValue)
                return CFrame.new(hitPos)
            end
        end
    end
    return _oldIndex(self, key)
end
setreadonly(_grm, true)

local gunHandlerPatched = false
local function patchGunHandler()
    if gunHandlerPatched then return end
    task.spawn(function()
        local modules = G.RS:FindFirstChild("Modules")
        if not modules then modules = G.RS:WaitForChild("Modules", 10) end
        if not modules then return end
        local gunhandler = modules:FindFirstChild("GunHandler")
        if not gunhandler then gunhandler = modules:WaitForChild("GunHandler", 10) end
        if not gunhandler then return end
        local ok, handler = pcall(require, gunhandler)
        if not ok or type(handler) ~= "table" then return end

        local function patchShoot(original)
            if type(original) ~= "function" then return original end
            return function(t, ...)
                if type(t) == "table" and rangeOn then
                    t.Range = rangeValue
                    if t.range then t.range = rangeValue end
                end
                return original(t, ...)
            end
        end

        if handler.Shoot then handler.Shoot = patchShoot(handler.Shoot) end
        if handler.shoot then handler.shoot = patchShoot(handler.shoot) end
        gunHandlerPatched = true
    end)
end

