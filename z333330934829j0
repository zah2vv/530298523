local function getPlayerHealthDisplay(target)
    if not target or not target.Character then return nil end
    local c = target.Character
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    
    local health = math.floor(hum.Health)
    
    -- Get armor
    local armor = 0
    local be = c:FindFirstChild("BodyEffects")
    if be then
        local a = be:FindFirstChild("Armor")
        if a then armor = a.Value end
    end
    
    -- Format: health 100/200 (health=green, armor=blue)
    return string.format('health  <font color="rgb(100,255,100)">%d</font>/<font color="rgb(100,200,255)">%d</font>', health, armor)
end

local function updateWatermark()
    if not f.watermark_hotkeys then
        container.Visible = false
        return
    end
    
    -- Get current targets
    local aimTarget = f.aim_assist and AimState.CurrentTarget
    local silentTarget = Silent.Enabled and Silent.Selected and Silent.Selected ~= G.LP and Silent.Selected
    
    -- Determine which target to show health for (prioritize aim assist if active)
    local healthTarget = aimTarget or silentTarget
    local healthText = healthTarget and getPlayerHealthDisplay(healthTarget)
    
    -- Check if anything changed
    local aimChanged = (aimTarget ~= lastAimTarget) or (f.aim_assist ~= lastAimEnabled)
    local silentChanged = (silentTarget ~= lastSilentTarget) or (Silent.Enabled ~= lastSilentEnabled)
    local healthChanged = (healthText ~= lastHealthValue)
    
    if not aimChanged and not silentChanged and not healthChanged and container.Visible then
        return
    end
    
    -- Update tracking
    lastAimTarget = aimTarget
    lastSilentTarget = silentTarget
    lastAimEnabled = f.aim_assist
    lastSilentEnabled = Silent.Enabled
    lastHealthValue = healthText
    
    -- Clear old labels
    for _, v in ipairs(container:GetChildren()) do v:Destroy() end
    
    local yOffset = 0
    local hasAny = false
    local lineHeight = 18
    
    -- AIM ASSIST label
    if f.aim_assist then
        local displayName = aimTarget and (aimTarget.DisplayName or aimTarget.Name) or "---"
        createLabel2(string.format('aim assist  <font color="rgb(200,200,255)">%s</font>', displayName), Color3.fromRGB(255,255,255), yOffset, lineHeight)
        yOffset = yOffset + lineHeight
        hasAny = true
    end
    
    -- SILENT AIM label
    if Silent.Enabled then
        local displayName = silentTarget and (silentTarget.DisplayName or silentTarget.Name) or "---"
        createLabel2(string.format('silent aim  <font color="rgb(252, 0, 0)">%s</font>', displayName), Color3.fromRGB(255,255,255), yOffset, lineHeight)
        yOffset = yOffset + lineHeight
        hasAny = true
    end
    
    -- SHARED HEALTH
    if healthText and (aimTarget or silentTarget) then
        createLabel2(healthText, Color3.fromRGB(255,255,255), yOffset, lineHeight)
        yOffset = yOffset + lineHeight
        hasAny = true
    end
    
    if hasAny then
        container.Visible = true
        container.Size = UDim2.new(0, 250, 0, yOffset)
    else
        container.Visible = false
    end
end

