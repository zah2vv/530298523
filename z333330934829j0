local function SilentCalcChance(pct) return math.random() <= pct / 100 end

-- IMPROVED VISIBILITY CHECK
local function SilentIsPartVisible(Part, PartDescendant)
    local char = G.LP.Character
    local params = RaycastParams.new()
    params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Blacklist, {char, G.C, PartDescendant}
    params.IgnoreWater = true
    local result = G.W:Raycast(G.C.CFrame.Position, Part.Position - G.C.CFrame.Position, params)
    return result == nil
end

-- IMPROVED PREDICTION
local function SilentGetPing()
    local Ok, Ping = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if not Ok or typeof(Ping) ~= "number" then
        return 60
    end
    return Ping
end

local function SilentPredicted(Part)
    if not Part then return nil end
    local Ping = SilentGetPing()
    local PredTime = Silent.Prediction + (math.clamp(Ping, 1, 200) - 60) * 0.00015
    return Part.Position + Part.AssemblyLinearVelocity * math.clamp(PredTime, 0, 0.3)
end

local function SilentIsFriend(p)
    if not p then return false end
    local ok, isF = pcall(function() return G.LP:IsFriendsWith(p.UserId) end)
    return ok and isF
end

local function SilentIsIgnored(p)
    if Silent.IgnoreFriends and SilentIsFriend(p) then return true end
    for _, ignored in ipairs(Silent.Ignored.Players) do if ignored == p then return true end end
    for _, team in ipairs(Silent.Ignored.Teams) do if p.Team == team[1] then return true end end
    return false
end

-- IMPROVED TARGET PART GETTING
local function SilentGetTargetPart(char)
    if not char then return nil end
    local parts = {}
    if typeof(Silent.TargetPart) == "string" then
        if Silent.TargetPart == "All" then
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("BasePart") then table.insert(parts, v) end
            end
        else
            local p = char:FindFirstChild(Silent.TargetPart)
            if p then table.insert(parts, p) end
        end
    elseif typeof(Silent.TargetPart) == "table" then
        for _, name in ipairs(Silent.TargetPart) do
            local p = char:FindFirstChild(name)
            if p then table.insert(parts, p) end
        end
    end
    -- Fallback to Head or HumanoidRootPart
    if #parts == 0 then
        local h = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if h then table.insert(parts, h) end
    end
    return parts
end

-- IMPROVED CLOSEST PLAYER WITH RANKING
local function SilentGetClosestPlayer()
    if Silent.Sticky.Enabled and Silent.Sticky.Target then
        local p = Silent.Sticky.Target
        if not p or p.Parent ~= G.P then Silent.Sticky.Target = nil
        else
            local char = p.Character
            if char and isValidTarget(p, Silent.Checks) then
                local parts = SilentGetTargetPart(char)
                for _, part in ipairs(parts) do
                    if Silent.Checks.Wall and not SilentIsPartVisible(part, char) then continue end
                    Silent.Selected, Silent.SelectedPart = p, part
                    return
                end
            end
            Silent.Selected, Silent.SelectedPart = nil, nil
            return
        end
    end
    if not SilentCalcChance(Silent.HitChance) then Silent.Selected, Silent.SelectedPart = nil, nil return end
    
    local mousePos = G.U:GetMouseLocation()
    local origin = G.C.CFrame.Position
    local myRoot = G.LP.Character and G.LP.Character:FindFirstChild("HumanoidRootPart")
    if myRoot then origin = myRoot.Position end
    
    local closestPlayer, targetPart, bestScore = nil, nil, math.huge
    
    for _, p in ipairs(G.P:GetPlayers()) do
        local char = p.Character
        if not SilentIsIgnored(p) and char and isValidTarget(p, Silent.Checks) then
            -- Distance check
            if not Silent.HvH and Silent.MaxDistance > 0 then
                local targetRoot = char:FindFirstChild("HumanoidRootPart")
                if myRoot and targetRoot and (myRoot.Position - targetRoot.Position).Magnitude > Silent.MaxDistance then
                    continue
                end
            end
            
            local parts = SilentGetTargetPart(char)
            for _, part in ipairs(parts) do
                -- Visibility
                if Silent.Checks.Wall and not SilentIsPartVisible(part, char) then continue end
                
                -- Prediction
                local predPos = SilentPredicted(part)
                if not predPos then predPos = part.Position end
                
                -- Screen position
                local screenPos, onScreen = G.C:WorldToViewportPoint(predPos)
                if not onScreen or screenPos.Z <= 0 then continue end
                
                -- FOV and distance ranking
                local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if Silent.UseFOV and SilentDraw.Circle.Radius < dist2D then continue end
                
                -- Score: 2D distance + weighted 3D distance
                local score = dist2D + ((origin - predPos).Magnitude * 0.45)
                if score < bestScore then
                    bestScore, closestPlayer, targetPart = score, p, part
                end
            end
        end
    end
    
    Silent.Selected, Silent.SelectedPart = closestPlayer, targetPart
end

-- HOOK THE MOUSE
local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = function(t, k)
    if t == G.Mouse and (k == "Hit" or k == "Target") and Silent.Enabled and Silent.SelectedPart then
        if Silent.Selected and not isValidTarget(Silent.Selected, Silent.Checks) then
            Silent.Selected, Silent.SelectedPart = nil, nil
            return oldIndex(t, k)
        end
        if k == "Hit" then
            local predPos = SilentPredicted(Silent.SelectedPart)
            local pos = predPos or Silent.SelectedPart.Position
            if getgenv().BypassAimView then
                local jitter = Vector3.new(math.random(-8,8)/1000, math.random(-8,8)/1000, math.random(-8,8)/1000)
                return CFrame.new(pos + jitter)
            end
            return CFrame.new(pos)
        elseif k == "Target" then return Silent.SelectedPart end
    end
    return oldIndex(t, k)
end
setreadonly(mt, true)

