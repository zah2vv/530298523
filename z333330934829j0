    -- ============================================
    -- KILL ALL
    -- ============================================
    _KillAllEnabled = false
    _KA_killAll = nil
    do
        local Kill = {Enabled = false, Auto = false, IgnoreFriends = false, Whitelist = {}}
        local KillGuns = {["[Double-Barrel SG]"]=true, ["[Revolver]"]=true, ["[TacticalShotgun]"]=true}
        local KillLoadout = {"[Double-Barrel SG]","[Revolver]","[TacticalShotgun]","None"}
        local KillRefillActive, KillRefillGen, KillLoopConn = false, 0, nil
        
        local function KillFindRemote(name)
            for _, obj in ipairs(G.RS:GetDescendants()) do if obj:IsA("RemoteEvent") and obj.Name:lower():find(name:lower(),1,true) then return obj end end
            return nil
        end
        local KillRemote2 = KillFindRemote("MainGameEvent") or KillFindRemote("MainRemoteEvent")
        local KillLoadoutRemote = KillFindRemote("Loadout")
        
        local function KillRequestAmmoRefill(tool, ammo)
            if KillLoadoutRemote == nil or KillRefillActive or tool == nil or ammo == nil or ammo:GetAttribute("ZeeKillRefillRequested") then return false end
            local char, bp = G.LP.Character, G.LP:FindFirstChild("Backpack")
            if bp == nil then return false end
            if ammo.Value > 3 then return false end
            ammo:SetAttribute("ZeeKillRefillRequested", true)
            KillRefillActive = true
            local reqName, oldTools, eqTools, newTools, seen = tool.Name, {}, {}, {}, {}
            for _, cont in ipairs({bp,char}) do
                if cont then for _, item in ipairs(cont:GetChildren()) do
                    if item:IsA("Tool") and KillGuns[item.Name] then
                        oldTools[item] = true
                        if item.Parent == char then eqTools[item.Name] = true end
                    end
                end end
            end
            local conns, stopped, deadline, lastAdd, gen = {}, false, os.clock()+2, os.clock(), KillRefillGen
            local function stop()
                if stopped then return end
                stopped = true
                for _, c in ipairs(conns) do c:Disconnect() end
                if not newTools[reqName] and ammo.Parent then ammo:SetAttribute("ZeeKillRefillRequested", nil) end
                KillRefillActive = false
            end
            local function accept(item)
                if not item:IsA("Tool") or not KillGuns[item.Name] or oldTools[item] or seen[item] then return end
                seen[item], lastAdd = true, os.clock()
                local name = item.Name
                local prev = newTools[name]
                if prev and prev ~= item and prev.Parent then prev:Destroy() end
                newTools[name] = item
                for old in pairs(oldTools) do if old.Name == name and old.Parent then old:Destroy() end end
                if eqTools[name] and char and item.Parent then item.Parent = char end
            end
            conns[1] = bp.ChildAdded:Connect(accept)
            if char then conns[2] = char.ChildAdded:Connect(accept) end
            KillLoadoutRemote:FireServer(KillLoadout)
            local heartbeat = G.R.Heartbeat:Connect(function()
                if gen ~= KillRefillGen then stop() return end
                if os.clock() >= deadline or (next(newTools) and os.clock()-lastAdd >= 0.2) then stop() end
            end)
            return true
        end
        
        local function KillUsableAmmo(tool, ammo)
            if ammo.Value <= 0 then KillRequestAmmoRefill(tool, ammo) return false end
            if not ammo:GetAttribute("ZeeKillAmmoWatching") then
                ammo:SetAttribute("ZeeKillAmmoWatching", true)
                local conn = ammo:GetPropertyChangedSignal("Value"):Connect(function()
                    if ammo.Value <= 0 then conn:Disconnect() KillRequestAmmoRefill(tool, ammo) end
                end)
            end
            return true
        end
        
        local function KillGetGun(char, bp) return bp:FindFirstChild("[TacticalShotgun]") or (char and char:FindFirstChild("[TacticalShotgun]")) end
        
        local function KillShouldSkip(p)
            if Kill.IgnoreFriends then local ok, isF = pcall(function() return G.LP:IsFriendsWith(p.UserId) end) if ok and isF then return true end end
            if Kill.Whitelist and next(Kill.Whitelist) then for _, name in ipairs(Kill.Whitelist) do if p.Name == name then return true end end end
            return false
        end
        
        local function KillAll()
            if not Kill.Enabled then return false end
            local char, bp = G.LP.Character, G.LP:FindFirstChild("Backpack")
            if char == nil or bp == nil then return false end
            local hum = char:FindFirstChildOfClass("Humanoid")
            local tool = KillGetGun(char, bp)
            local handle = tool and tool:FindFirstChild("Handle")
            local ammo = tool and tool:FindFirstChild("Ammo")
            if KillRemote2 == nil or hum == nil or tool == nil or handle == nil or ammo == nil then return false end
            if not KillUsableAmmo(tool, ammo) then return false end
            local pellets, targets = {}, 0
            for _, p in ipairs(G.P:GetPlayers()) do
                if p ~= G.LP and not KillShouldSkip(p) then
                    local tc = p.Character
                    if tc and tc.Parent then
                        local th, head = tc:FindFirstChild("Humanoid"), tc:FindFirstChild("Head")
                        if th and th.Health > 0 and head then
                            local be, ko = tc:FindFirstChild("BodyEffects"), false
                            if be then local koVal = be:FindFirstChild("K.O") if koVal and koVal.Value == true then ko = true end end
                            if not ko then
                                targets = targets + 1
                                local pos = head.Position
                                for _ = 1, 20 do pellets[#pellets+1] = {AimPosition=pos, Result1=pos, Result2=head, Result3=Vector3.yAxis} end
                            end
                        end
                    end
                end
            end
            if #pellets == 0 then return false end
            local rangeObj, dmgObj = tool:FindFirstChild("Range"), tool:FindFirstChild("Damage")
            local range, dmg = rangeObj and rangeObj.Value or 200, dmgObj and dmgObj.Value or 50
            tool.Enabled = true
            if tool.Parent ~= char then tool.Parent = char end
            for _ = 1, 8 do KillRemote2:FireServer("ShootGun", handle, handle.Position, pellets, nil, nil, nil, range, dmg) end
            if tool.Parent then tool.Parent = bp end
            task.spawn(function()
                task.wait(0.3)
                local char2, bp2 = G.LP.Character, G.LP:FindFirstChild("Backpack")
                if not char2 and not bp2 then return end
                local tool2 = char2 and char2:FindFirstChildOfClass("Tool")
                if tool2 and tool2:FindFirstChild("Ammo") then
                    local ammo2 = tool2:FindFirstChild("Ammo")
                    if ammo2.Value <= 3 and not ammo2:GetAttribute("ZeeKillRefillRequested") then KillRequestAmmoRefill(tool2, ammo2) end
                end
                if bp2 then for _, item in ipairs(bp2:GetChildren()) do
                    if item:IsA("Tool") and KillGuns[item.Name] and item:FindFirstChild("Ammo") then
                        local ammo2 = item:FindFirstChild("Ammo")
                        if ammo2.Value <= 3 and not ammo2:GetAttribute("ZeeKillRefillRequested") then KillRequestAmmoRefill(item, ammo2) end
                    end
                end end
            end)
            return targets > 0
        end
        _KA_killAll = KillAll
        
        local function KillStartAutoLoop()
            if KillLoopConn then return end
            KillLoopConn = G.R.Heartbeat:Connect(function() if Kill.Enabled and Kill.Auto then KillAll() end end)
        end
        
        local function KillStopAutoLoop()
            if KillLoopConn then KillLoopConn:Disconnect() KillLoopConn = nil end
        end
        
        local function KillDisableWeaponMods()
            if InfRangeEnabled then
                InfRangeEnabled = false
                for gun, _ in pairs(PatchedGuns) do CleanupGun(gun) end
                pcall(function() if Sections.WeaponsLeft and Sections.WeaponsLeft.Toggles and Sections.WeaponsLeft.Toggles.inf_range then Sections.WeaponsLeft.Toggles.inf_range:Set(false) end end)
            end
            if RapidFireEnabled then
                RapidFireEnabled = false
                for tool, _ in pairs(RapidFireTools) do CleanupRapidFire(tool) end
                RapidFireTools = {}
                pcall(function() if Sections.WeaponsLeft and Sections.WeaponsLeft.Toggles and Sections.WeaponsLeft.Toggles.rapid_fire then Sections.WeaponsLeft.Toggles.rapid_fire:Set(false) end end)
            end
        end
        
        local KillToggle = Sections.RageRight:Toggle({Name = 'kill all', Flag = 'Kill_All', Default = false, Callback = function(v)
            Kill.Enabled = v
            _KillAllEnabled = v
            if v then KillDisableWeaponMods() if Kill.Auto then KillStartAutoLoop() end
            else KillStopAutoLoop() end
        end})
        
        Sections.RageRight:Toggle({Name = 'auto kill all', Flag = 'auto_kill_all', Default = false, Callback = function(v)
            Kill.Auto = v
            if v and Kill.Enabled then KillDisableWeaponMods() KillStartAutoLoop()
            elseif not v then KillStopAutoLoop() end
        end})
        
        KillToggle:Keybind({Flag = 'kill_all_bind', Mode = 'Hold', Callback = function(s) if s and Kill.Enabled and type(_KA_killAll) == "function" then _KA_killAll() end end})
        
        Sections.RageRight:Toggle({Name = 'ignore friends', Flag = 'ignore_friends', Default = false, Callback = function(v) Kill.IgnoreFriends = v end})
        
        local function KillGetNames()
            local t = {}
            for _, p in ipairs(G.P:GetPlayers()) do if p ~= G.LP then table.insert(t, p.Name) end end
            return t
        end
        
        local wlDropdown = Sections.RageRight:Dropdown({Name = 'whitelist players', Flag = 'whitelist_players', Items = KillGetNames(), Default = {}, Multi = true, Callback = function(v) Kill.Whitelist = v or {} end})
        
        local function KillRefreshWhitelist()
            local names = KillGetNames()
            if type(wlDropdown.Refresh) == "function" then wlDropdown:Refresh(names)
            elseif type(wlDropdown.SetItems) == "function" then wlDropdown:SetItems(names)
            elseif type(wlDropdown.SetValues) == "function" then wlDropdown:SetValues(names) end
        end
        G.P.PlayerAdded:Connect(KillRefreshWhitelist)
        G.P.PlayerRemoving:Connect(KillRefreshWhitelist)
        task.defer(function()
            task.wait(0.1)
            local inst = typeof(wlDropdown) == "Instance" and wlDropdown or (type(wlDropdown) == "table" and wlDropdown.Instance)
            if inst then for _, d in ipairs(inst:GetDescendants()) do if d:IsA("GuiButton") then d.Activated:Connect(KillRefreshWhitelist) break end end end
        end)
    end
    
    -- ============================================
    -- SPECTATE
    -- ============================================
    local Spec = {Names = {}, Selected = nil, Active = false, Connection = nil, Dropdown = nil}
    
    local function UpdateSpecNames()
        Spec.Names = {}
        for _, p in ipairs(G.P:GetPlayers()) do if p ~= G.LP then table.insert(Spec.Names, p.Name) end end
        table.sort(Spec.Names)
    end
    
    local function StartSpectate(name)
        local target = G.P:FindFirstChild(name)
        if not target then return false end
        local hum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        G.C.CameraSubject = hum
        if Spec.Connection then Spec.Connection:Disconnect() end
        Spec.Connection = target.CharacterAdded:Connect(function(newChar)
            if not Spec.Active then return end
            local h = newChar:WaitForChild("Humanoid", 5)
            if h then G.C.CameraSubject = h end
        end)
        return true
    end
    
    local function StopSpectate()
        Spec.Active = false
        if Spec.Connection then Spec.Connection:Disconnect() Spec.Connection = nil end
        local char = G.LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then G.C.CameraSubject = hum end
    end
    
    local function RefreshSpecDropdown()
        UpdateSpecNames()
        if not Spec.Dropdown then return end
        for _, m in ipairs({"Refresh","SetItems","SetOptions","UpdateItems","SetValues"}) do
            if Spec.Dropdown[m] then local ok = pcall(function() Spec.Dropdown[m](Spec.Dropdown, Spec.Names) end) if ok then break end end
        end
    end
    
    UpdateSpecNames()
    Spec.Dropdown = Sections.RageRight:Dropdown({Name = 'player list', Flag = 'spectate_playerlist', Items = Spec.Names, Default = Spec.Names[1] or "", Multi = false, Callback = function(v)
        Spec.Selected = v
        if Spec.Active then StartSpectate(v) end
    end})
    
    task.defer(function()
        task.wait(0.1)
        local inst = typeof(Spec.Dropdown) == "Instance" and Spec.Dropdown or (type(Spec.Dropdown) == "table" and Spec.Dropdown.Instance)
        if inst then for _, d in ipairs(inst:GetDescendants()) do if d:IsA("GuiButton") then d.Activated:Connect(RefreshSpecDropdown) break end end end
    end)
    
    local specToggle = Sections.RageRight:Toggle({Name = 'spectate', Flag = 'Spectate', Default = false, Callback = function(v)
        Spec.Active = v
        if v then
            local target = Spec.Selected or (Spec.Dropdown.Value ~= "" and Spec.Dropdown.Value) or Spec.Names[1]
            if target and target ~= "" then
                if not StartSpectate(target) then pcall(function() specToggle:Set(false) end) end
            else pcall(function() specToggle:Set(false) end) end
        else StopSpectate() end
    end})
    
    G.P.PlayerAdded:Connect(RefreshSpecDropdown)
    G.P.PlayerRemoving:Connect(function(p)
        local was = Spec.Active and Spec.Selected == p.Name
        RefreshSpecDropdown()
        if was then StopSpectate() pcall(function() specToggle:Set(false) end) end
    end)
    G.LP.CharacterAdded:Connect(function(char)
        if Spec.Active then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then G.C.CameraSubject = hum end
    end)
    
