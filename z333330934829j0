-- REMOVE DELAY + HOLD MODE (FILTERED)
-- ============================================

local delayOn = false
local delayGuns = {}
local holdActive = false
local holdConn = nil
local mouseDownConn = nil
local mouseUpConn = nil
local holdDelay = 0.05
local lastFireTime = 0

local function setupDelay(gun)
    if delayGuns[gun] then return end
    if gun.Parent ~= G.LP.Character then return end
    if not isGunSelected(gun) then return end  -- <-- FILTER
    
    local gs = gun:FindFirstChild("GunScript")
    local fr = gun:FindFirstChild("FireRate") or gun:FindFirstChild("Rate") or gun:FindFirstChild("ShootRate")
    local cd = gun:FindFirstChild("ShootingCooldown")
    
    if gs then
        local conns = getconnections(gun.Activated)
        for _, c in ipairs(conns) do
            local fn = c.Function
            if fn then
                local info = debug.getinfo(fn)
                for i = 1, (info.nups or 0) do
                    local val = debug.getupvalue(fn, i)
                    if type(val) == "number" and val > 0.05 and val < 1 then
                        debug.setupvalue(fn, i, 0)
                    end
                end
            end
        end
    end
    if fr and fr:IsA("NumberValue") then fr.Value = 0 end
    if cd and cd:IsA("NumberValue") then cd.Value = 0 end
    
    delayGuns[gun] = true
end

local function clearDelayGuns()
    delayGuns = {}
end

local function startHoldMode()
    if holdConn then return end
    
    mouseDownConn = G.U.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if not delayOn then return end
            local char = G.LP.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool or not tool:FindFirstChild("Ammo") then return end
            if not isGunSelected(tool) then return end  -- <-- FILTER
            
            if not delayGuns[tool] then setupDelay(tool) end
            holdActive = true
            lastFireTime = 0
            
            if holdConn then holdConn:Disconnect() holdConn = nil end
            
            holdConn = G.R.Heartbeat:Connect(function()
                if not holdActive or not delayOn then
                    if holdConn then holdConn:Disconnect() holdConn = nil end
                    return
                end
                local char2 = G.LP.Character
                if not char2 then holdActive = false return end
                local tool2 = char2:FindFirstChildOfClass("Tool")
                if not tool2 or not tool2:FindFirstChild("Ammo") then holdActive = false return end
                if not isGunSelected(tool2) then  -- <-- FILTER
                    holdActive = false
                    return
                end
                
                local now = tick()
                if now - lastFireTime >= holdDelay then
                    pcall(tool2.Activate, tool2)
                    lastFireTime = now
                end
            end)
        end
    end)
    
    mouseUpConn = G.U.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            holdActive = false
            if holdConn then holdConn:Disconnect() holdConn = nil end
        end
    end)
end

local function stopHoldMode()
    holdActive = false
    if holdConn then holdConn:Disconnect() holdConn = nil end
    if mouseDownConn then mouseDownConn:Disconnect() mouseDownConn = nil end
    if mouseUpConn then mouseUpConn:Disconnect() mouseUpConn = nil end
end

local function scanDelay()
    if not delayOn then return end
    local char = G.LP.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Ammo") and isGunSelected(tool) then  -- <-- FILTER
        if not delayGuns[tool] then setupDelay(tool) end
    end
end

